{$CADDY_DOMAIN} {
	# JoinFS live aircraft WebSocket feed. JoinFS's HttpListener only serves URLs under
	# /ws/ (WebSocketServer.cs), so the path is forwarded unchanged - do NOT strip the prefix
	# (handle_path) or JoinFS answers 404.
	handle /ws/* {
		reverse_proxy joinfs:8765
	}

	# tsapi's Flask routes, proxied as-is (no path rewriting).
	@api path /usertochannel* /users* /channels* /channel* /move*
	handle @api {
		reverse_proxy tsapi:8081
	}

	handle {
		respond "Not Found" 404
	}
}
